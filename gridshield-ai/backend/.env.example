# IBM watsonx.ai credentials (required for AI agent analysis)
# Obtain from https://cloud.ibm.com/iam/apikeys
IBM_WATSONX_API_KEY=your_ibm_cloud_api_key_here
IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Langflow (optional - if using IBM Langflow endpoint instead of direct watsonx)
IBM_LANGFLOW_URL=https://your-langflow-instance.ibm.com
IBM_LANGFLOW_API_KEY=your_langflow_api_key_here
IBM_LANGFLOW_FLOW_ID=your_flow_id_here

# Database (SQLite by default - change for PostgreSQL in production)
DATABASE_URL=sqlite+aiosqlite:///./gridshield.db

# App settings
APP_SECRET_KEY=change-this-in-production
APP_ENV=development
DATA_DIR=./data

# Anomaly detection thresholds (tunable)
ANOMALY_ZSCORE_THRESHOLD=2.5
SUDDEN_DROP_THRESHOLD=0.40
SUDDEN_SPIKE_THRESHOLD=2.50
MIN_HISTORY_MONTHS=3
